{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "firenef": ["javascript/firenef.js"],
            "three": ["three.js/three.js"],
            "rapier3d": ["rapier3d"],
            "rapier2d": ["rapier.js/rapier2d.js"],
            "pixi": ["pixi.js/pixi.js"]
        },
        "allowJs": true,
        "moduleResolution": "node"
    },
    "include": [
        "javascript/**/*",
        "three.js/**/*",
        "rapier.js/**/*",
        "pixi.js/**/*"
    ],
    "exclude": [
        "three.js/addons/**/*"
    ]
}
